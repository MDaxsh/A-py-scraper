# ============================================================
# INDEED WEBSITE CONFIGURATION
# ============================================================
# This file contains all settings related to the Indeed website
# including URLs, search parameters, and authentication.
# ============================================================

# ------------------------------------------------------------
# BASE URL SETTINGS
# ------------------------------------------------------------
# The main Indeed website URL. Change for different regions:
# - US: https://www.indeed.com
# - UK: https://uk.indeed.com
# - Canada: https://ca.indeed.com
# - India: https://www.indeed.co.in
INDEED_BASE_URL=https://www.indeed.com

# ------------------------------------------------------------
# SEARCH PARAMETERS
# ------------------------------------------------------------
# The job title, skills, or keywords to search for
INDEED_SEARCH_QUERY=react developer

# Location for job search (city, state, or "Remote")
INDEED_LOCATION=los angeles, ca

# ------------------------------------------------------------
# OPTIONAL FILTERS
# ------------------------------------------------------------
# Job type filter (leave empty to skip)
# Options: fulltime, parttime, contract, temporary, internship
INDEED_JOB_TYPE=

# Days since job was posted (leave empty for all)
# Options: 1, 3, 7, 14 (days)
INDEED_DATE_POSTED=
