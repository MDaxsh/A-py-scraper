# ============================================================
# PLAYWRIGHT BROWSER CONFIGURATION
# ============================================================
# This file controls how the browser behaves when loading pages.
# Playwright is the tool that automates the browser.
# ============================================================

# ------------------------------------------------------------
# BROWSER TYPE
# ------------------------------------------------------------
# Which browser engine to use
# Options: chromium, firefox, webkit
PLAYWRIGHT_BROWSER=chromium

# ------------------------------------------------------------
# VISIBILITY SETTINGS
# ------------------------------------------------------------
# Whether to show the browser window or run invisibly
# true = invisible (faster, for production)
# false = visible (watch it work, for debugging)
PLAYWRIGHT_HEADLESS=false

# Slow down actions by this many milliseconds
# 0 = full speed, 500 = half second delay between actions
# Higher values let you see what's happening more clearly
PLAYWRIGHT_SLOW_MO=1000

# ------------------------------------------------------------
# BROWSER WINDOW SIZE
# ------------------------------------------------------------
# Width of the browser window in pixels
PLAYWRIGHT_VIEWPORT_WIDTH=1280

# Height of the browser window in pixels
PLAYWRIGHT_VIEWPORT_HEIGHT=800

# ------------------------------------------------------------
# TIMEOUT SETTINGS (in milliseconds)
# ------------------------------------------------------------
# How long to wait for page elements (30000 = 30 seconds)
PLAYWRIGHT_DEFAULT_TIMEOUT=30000

# How long to wait for page navigation (60000 = 60 seconds)
PLAYWRIGHT_NAVIGATION_TIMEOUT=60000

# ------------------------------------------------------------
# SCREENSHOT SETTINGS
# ------------------------------------------------------------
# Whether to take screenshots during execution
# true = save screenshots, false = skip screenshots
PLAYWRIGHT_SCREENSHOTS=true

# Folder where screenshots will be saved
PLAYWRIGHT_SCREENSHOT_DIR=./output/screenshots
